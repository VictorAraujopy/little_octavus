<!--
  Octavus's body and the sea floor, in MuJoCo's MJCF format.

  The octopus has 8 arms. Each arm has 3 segments and 6 motors:
    shoulder_swing - swings the arm sideways (sweeps forward/back)
    shoulder_lift  - lifts the whole arm off the floor or pushes it down
    elbow          - bends the middle segment up/down
    tip_bend       - bends the tip up/down      (weak muscle: the tip stays soft)
    tip_curl       - curls the tip sideways    (weak muscle: the tip stays soft)
    sucker         - sticks the tip to whatever it is touching (floor, crab)
  Plus a touch sensor on the tip. In total: 48 motors and 8 touch sensors.
  Mantle, web, eyes and the curled tip are visual only: no mass, no collision.

  View it (from the project root; the path must be absolute, hence $PWD):
    uv run python -m mujoco.viewer --mjcf="$PWD/world_octavus/octopus.xml"
-->
<mujoco model="octavus">
  <compiler angle="degree" autolimits="true"/>

  <!-- sea water: Earth's gravity, and each body's gravcomp is the buoyancy (MuJoCo's fluid only adds drag) -->
  <option timestep="0.005" integrator="implicitfast" gravity="0 0 -9.81" density="1025" viscosity="0.001"/>

  <visual>
    <rgba haze="0.05 0.25 0.35 1" fog="0.03 0.18 0.26 1"/>
    <map fogstart="1.5" fogend="7"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture name="water" type="skybox" builtin="gradient" rgb1="0.1 0.4 0.55" rgb2="0.01 0.06 0.1" width="512" height="512"/>
    <texture name="sand" type="2d" builtin="checker" rgb1="0.78 0.71 0.52" rgb2="0.72 0.65 0.47" width="512" height="512"/>
    <material name="sand" texture="sand" texrepeat="12 12"/>
    <material name="skin" rgba="0.85 0.33 0.25 1"/>
    <material name="tip" rgba="0.9 0.42 0.33 1"/>
    <material name="sucker" rgba="1 0.8 0.72 1"/>
    <material name="eye" rgba="0.95 0.93 0.8 1"/>
    <material name="pupil" rgba="0.05 0.05 0.05 1"/>
  </asset>

  <default>
    <!-- slippery skin (mucus on wet sand): the suckers do the gripping. The floor inherits it: MuJoCo uses the larger of the two -->
    <geom material="skin" contype="2" conaffinity="1" friction="0.3 0.02 0.01"/>
    <joint damping="0.5" armature="0.01"/>
    <default class="muscle">
      <position kp="40" kv="1" forcerange="-25 25" inheritrange="1"/>
    </default>
    <!-- weak muscles on the tip: it gives and sways in the water instead of snapping into place -->
    <default class="soft_muscle">
      <position kp="8" kv="0.3" forcerange="-4 4" inheritrange="1"/>
    </default>
    <default class="visual">
      <geom contype="0" conaffinity="0" density="0"/>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 6" dir="0 0 -1" directional="true" diffuse="0.55 0.7 0.8" castshadow="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="sand" contype="1" conaffinity="1"/>

    <body name="target" mocap="true" pos="2 0 0.005">
      <geom class="visual" type="cylinder" size="0.12 0.005" rgba="1 0.25 0.2 0.7"/>
    </body>

    <!-- gravcomp 0.952: an octopus is ~5% denser than sea water, so the water holds 1/1.05 of its weight -->
    <body name="torso" pos="0 0 0.19" gravcomp="0.952">
      <freejoint name="root"/>
      <camera name="follow" mode="trackcom" pos="0 -1.8 1.1" xyaxes="1 0 0 0 0.53 0.848"/>
      <geom name="head" type="sphere" size="0.12"/>
      <geom name="mantle" class="visual" type="ellipsoid" size="0.15 0.13 0.2" pos="-0.1 0 0.14" euler="0 -35 0"/>
      <geom name="web" class="visual" type="ellipsoid" size="0.2 0.2 0.035" pos="0 0 -0.07"/>
      <geom class="visual" material="eye" type="sphere" size="0.042" pos="0.04 0.085 0.085"/>
      <geom class="visual" material="eye" type="sphere" size="0.042" pos="0.04 -0.085 0.085"/>
      <geom class="visual" material="pupil" type="ellipsoid" size="0.02 0.007 0.007" pos="0.055 0.11 0.11"/>
      <geom class="visual" material="pupil" type="ellipsoid" size="0.02 0.007 0.007" pos="0.055 -0.11 0.11"/>

      <replicate count="8" euler="0 0 45">
        <body name="arm" pos="0.0924 0.0383 -0.05" euler="0 0 22.5" gravcomp="0.952">
          <joint name="shoulder_swing" axis="0 0 1" range="-30 30"/>
          <joint name="shoulder_lift" axis="0 1 0" range="-35 35"/>
          <geom type="capsule" fromto="0 0 0 0.25 0 -0.09" size="0.045"/>
          <body name="mid" pos="0.25 0 -0.09" euler="0 6 0" gravcomp="0.952">
            <joint name="elbow" axis="0 1 0" range="-40 40"/>
            <geom material="tip" type="capsule" fromto="0 0 0 0.18 0 0" size="0.032"/>
            <geom class="visual" material="tip" type="capsule" fromto="0 0 0 0.07 0 0" size="0.038"/>
            <body name="tip" pos="0.18 0 0" euler="0 3 0" gravcomp="0.952">
              <joint name="tip_bend" axis="0 1 0" range="-45 45"/>
              <joint name="tip_curl" axis="0 0 1" range="-45 45"/>
              <geom material="tip" type="capsule" fromto="0 0 0 0.15 0 0" size="0.022"/>
              <site name="touch" type="capsule" fromto="0 0 0 0.15 0 0" size="0.027" rgba="0 0 0 0"/>
              <geom class="visual" material="tip" type="capsule" fromto="0 0 0 0.05 0 0" size="0.027"/>
              <geom class="visual" material="tip" type="capsule" fromto="0.15 0 0 0.206 0 0.0084" size="0.018"/>
              <geom class="visual" material="tip" type="capsule" fromto="0.206 0 0.0084 0.248 0 0.0315" size="0.015"/>
              <geom class="visual" material="tip" type="capsule" fromto="0.248 0 0.0315 0.269 0 0.0665" size="0.012"/>
              <geom class="visual" material="tip" type="capsule" fromto="0.269 0 0.0665 0.2585 0 0.098" size="0.01"/>
              <geom class="visual" material="tip" type="capsule" fromto="0.2585 0 0.098 0.2305 0 0.112" size="0.008"/>
              <geom class="visual" material="tip" type="capsule" fromto="0.2305 0 0.112 0.2095 0 0.098" size="0.006"/>
              <geom class="visual" material="sucker" type="sphere" size="0.007" pos="0.2424 0 0.0434"/>
              <geom class="visual" material="sucker" type="sphere" size="0.0065" pos="0.255 0 0.07"/>
              <geom class="visual" material="sucker" type="sphere" size="0.005" pos="0.2466 0 0.091"/>
            </body>
          </body>
        </body>
      </replicate>
    </body>
  </worldbody>

  <actuator>
    <position class="muscle" name="shoulder_swing" joint="shoulder_swing"/>
    <position class="muscle" name="shoulder_lift" joint="shoulder_lift"/>
    <position class="muscle" name="elbow" joint="elbow"/>
    <position class="soft_muscle" name="tip_bend" joint="tip_bend"/>
    <position class="soft_muscle" name="tip_curl" joint="tip_curl"/>
    <adhesion name="sucker" body="tip" ctrlrange="0 1" gain="120"/>
  </actuator>

  <sensor>
    <touch name="touch" site="touch"/>
  </sensor>
</mujoco>
